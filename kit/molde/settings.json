{
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/cambios.cjs:*)"
    ],
    "ask": [
      "Bash(node .claude/scripts/cambios.cjs aprobar:*)",
      "PowerShell(node .claude/scripts/cambios.cjs aprobar:*)"
    ],
    "deny": [
      "Write(./.claude/cambios/**)",
      "Edit(./.claude/cambios/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.cjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/escritura-docs.cjs\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/niega-aprobar.cjs\"",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
